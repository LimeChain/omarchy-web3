{
  "schemaVersion": 1,
  "id": "limechain.web3",
  "name": "LimeChain Web3 Workstation",
  "version": "0.1.0",
  "author": "LimeChain",
  "license": "MIT",
  "description": "Non-custodial EVM telemetry and local Anvil controls for Omarchy Quattro.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "plugin/Web3Panel.qml"
  },
  "barWidget": {
    "displayName": "Web3 Workstation",
    "description": "Read-only chain telemetry and fixed local Anvil controls.",
    "category": "Development",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
