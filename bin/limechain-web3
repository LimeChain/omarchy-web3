APP_ID = "limechain.web3"
MENU_BEGIN = "// BEGIN limechain.web3 (managed by limechain-web3)"
MENU_END = "// END limechain.web3"
SENSITIVE_KEY = re.compile(r"(private.?key|mnemonic|seed|keystore|password|secret)", re.I)
HEDERA_NETWORKS = {
    "mainnet": {
        "mirror_url": "https://mainnet-public.mirrornode.hedera.com/api/v1",
        "explorer_url": "https://hashscan.io/mainnet",
    },
    "testnet": {
        "mirror_url": "https://testnet.mirrornode.hedera.com/api/v1",
        "explorer_url": "https://hashscan.io/testnet",
    },
    "previewnet": {
        "mirror_url": "https://previewnet.mirrornode.hedera.com/api/v1",
        "explorer_url": "https://hashscan.io/previewnet",
    },
}
HEDERA_ACCOUNT = re.compile(r"(?:0\.0\.[0-9]{1,19}|0x[0-9a-fA-F]{40})")
HEDERA_TRANSACTION = re.compile(r"0\.0\.[0-9]{1,19}(?:-|@)[0-9]{10}\.[0-9]{1,9}")


def _home() -> Path:
    return Path(os.environ.get("LCW3_HOME", str(Path.home()))).expanduser()


def _xdg(name: str, fallback: Path) -> Path:
    return Path(os.environ.get(name, str(fallback))).expanduser()


def data_home() -> Path:
    return _xdg("LCW3_DATA_HOME", _home() / ".local" / "share")


def config_home() -> Path:
    return _xdg("LCW3_CONFIG_HOME", _home() / ".config")


def state_home() -> Path:
    return _xdg("LCW3_STATE_HOME", _home() / ".local" / "state")


def app_root() -> Path:
    return Path(os.environ.get("LCW3_APP_ROOT", str(data_home() / "limechain-web3")))


def config_path() -> Path:
    return Path(os.environ.get("LCW3_CONFIG_FILE", str(config_home() / "limechain-web3" / "config.json")))


def install_state_path() -> Path:
    return Path(
        os.environ.get(
            "LCW3_INSTALL_STATE",
            str(state_home() / "limechain-web3" / "install-state.json"),
        )
    )


def installed_profiles() -> list[str]:
    override = os.environ.get("LCW3_LOCK_FILE")
    if override:
        try:
            return [str(read_json(Path(override)).get("profile", "evm-core"))]
        except RuntimeError:
            return ["evm-core"]
    try:
        state = read_json(install_state_path())
    except RuntimeError:
        return ["evm-core"]
    profiles = state.get("profiles")
    if isinstance(profiles, list):
        return sorted(
            {
                str(profile)
                for profile in profiles
                if profile in {"evm-core", "solana-core", "hedera-core"}
            }
        )
    profile = str(state.get("profile", "evm-core"))
    return [profile] if profile in {"evm-core", "solana-core", "hedera-core"} else ["evm-core"]


def lock_paths() -> list[Path]:
    override = os.environ.get("LCW3_LOCK_FILE")
    if override:
        return [Path(override)]
    return [app_root() / "toolchains" / f"{profile}.lock.json" for profile in installed_profiles()]


def locked_artifact_version(artifact_id: str) -> str:
    for path in lock_paths():
        try:
            lock = read_json(path)
        except RuntimeError:
            continue
        for artifact in lock.get("artifacts", []):
            if artifact.get("id") == artifact_id:
                return str(artifact.get("version", ""))
    return ""


def raw_bin_dir() -> Path:
    return app_root() / "raw-bin"


def env_bin_dir() -> Path:
    return app_root() / "env" / "bin"


def sample_root() -> Path:
    return app_root() / "samples" / "counter"


def anchor_sample_root() -> Path:
    return app_root() / "samples" / "anchor-counter"


def solana_home() -> Path:
    return app_root() / "solana-home"


def systemd_unit_path() -> Path:
    return Path(
        os.environ.get(
            "LCW3_SYSTEMD_UNIT",
            str(config_home() / "systemd" / "user" / "limechain-web3-anvil.service"),
        )
    )


def surfpool_systemd_unit_path() -> Path:
    return Path(
        os.environ.get(
            "LCW3_SURFPOOL_SYSTEMD_UNIT",
            str(config_home() / "systemd" / "user" / "limechain-web3-surfpool.service"),
        )
    )


def menu_path() -> Path:
    return Path(
        os.environ.get(
            "LCW3_MENU_FILE",
            str(config_home() / "omarchy" / "extensions" / "omarchy-menu.jsonc"),
        )
    )


def json_dump(value: Any) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise RuntimeError(f"missing required file: {path}") from exc
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid JSON in {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise RuntimeError(f"expected a JSON object in {path}")
    return value


def atomic_write(path: Path, content: str, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        raise RuntimeError(f"refusing to replace a symlink: {path}")
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temp_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_path, mode)
        temp_path.replace(path)
    except BaseException:
        temp_path.unlink(missing_ok=True)
        raise


def load_config() -> dict[str, Any]:
    return read_json(config_path())


def write_config(config: dict[str, Any]) -> None:
    path = config_path()
    atomic_write(path, json.dumps(config, indent=2, sort_keys=True) + "\n", 0o600)


def validate_public_rpc_url(value: str, *, allow_local: bool = False, resolve: bool = False) -> str:
    try:
        parsed = urllib.parse.urlsplit(value)
    except ValueError as exc:
        raise RuntimeError("RPC URL is malformed") from exc
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        raise RuntimeError("RPC URL must use http:// or https://")
    if parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise RuntimeError("RPC URLs containing credentials, query strings, or fragments are refused")
    hostname = parsed.hostname.lower()
    try:
        literal_ip = ipaddress.ip_address(hostname)
    except ValueError:
        literal_ip = None
    is_literal_loopback = literal_ip is not None and literal_ip.is_loopback
    is_named_loopback = hostname == "localhost"
    if allow_local:
        if not (is_literal_loopback or is_named_loopback):
            raise RuntimeError("local RPC must be bound to loopback")
    elif is_literal_loopback or is_named_loopback:
        raise RuntimeError("use the local RPC configuration for loopback endpoints")
    elif literal_ip is not None and not literal_ip.is_global:
        raise RuntimeError("remote RPC must not target a private, link-local, or reserved address")
    if resolve and not allow_local:
        try:
            addresses = {
                ipaddress.ip_address(item[4][0])
                for item in socket.getaddrinfo(hostname, parsed.port or (443 if parsed.scheme == "https" else 80))
            }
        except (OSError, ValueError) as exc:
            raise RuntimeError("remote RPC hostname could not be resolved safely") from exc
        if not addresses or any(not address.is_global for address in addresses):
            raise RuntimeError("remote RPC resolved to a non-public address")
    return urllib.parse.urlunsplit(parsed)


def validate_explorer_url(value: str) -> str:
    if not value:
        return ""
    parsed = urllib.parse.urlsplit(value)
    if parsed.scheme != "https" or not parsed.hostname:
        raise RuntimeError("explorer URL must use https://")
    if parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise RuntimeError("explorer URL must not contain credentials, a query, or a fragment")
    return urllib.parse.urlunsplit(parsed).rstrip("/")


def rpc_call(url: str, method: str, params: list[Any], timeout: float) -> Any:
    payload = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
    request = urllib.request.Request(
        url,
        data=payload,
        method="POST",
        headers={"Content-Type": "application/json", "User-Agent": "limechain-web3/0.1"},
    )
    try:
        opener = urllib.request.build_opener(_NoRedirectHandler())
        with opener.open(request, timeout=timeout) as response:
            if response.length is not None and response.length > 1_048_576:
                raise RuntimeError("RPC response exceeded the 1 MiB limit")
            body = response.read(1_048_577)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise RuntimeError(f"RPC unavailable: {exc.__class__.__name__}") from exc
    if len(body) > 1_048_576:
        raise RuntimeError("RPC response exceeded the 1 MiB limit")
    try:
        decoded = json.loads(body)
    except json.JSONDecodeError as exc:
        raise RuntimeError("RPC returned invalid JSON") from exc
    if not isinstance(decoded, dict) or decoded.get("error"):
        raise RuntimeError("RPC returned an error")
    return decoded.get("result")


def from_hex(value: Any) -> int | None:
    if not isinstance(value, str) or not value.startswith("0x"):
        return None
    try:
        return int(value, 16)
    except ValueError:
        return None


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req: Any, fp: Any, code: int, msg: str, headers: Any, newurl: str) -> None:
        return None


def rpc_snapshot(url: str, timeout: float, *, local: bool) -> dict[str, Any]:
    safe_url = validate_public_rpc_url(url, allow_local=local, resolve=not local)
    started = time.monotonic()
    chain_id = from_hex(rpc_call(safe_url, "eth_chainId", [], timeout))
    block_height = from_hex(rpc_call(safe_url, "eth_blockNumber", [], timeout))
    gas_price = from_hex(rpc_call(safe_url, "eth_gasPrice", [], timeout))
    latest_block = rpc_call(safe_url, "eth_getBlockByNumber", ["latest", False], timeout)
    base_fee = from_hex(latest_block.get("baseFeePerGas")) if isinstance(latest_block, dict) else None
    return {
        "ok": True,
        "chain_id": chain_id,
        "block_height": block_height,
        "gas_gwei": round(gas_price / 1_000_000_000, 3) if gas_price is not None else None,
        "base_fee_gwei": round(base_fee / 1_000_000_000, 3) if base_fee is not None else None,
        "latency_ms": round((time.monotonic() - started) * 1000),
    }


def solana_rpc_snapshot(url: str, timeout: float) -> dict[str, Any]:
    safe_url = validate_public_rpc_url(url, allow_local=True)
    started = time.monotonic()
    health = rpc_call(safe_url, "getHealth", [], timeout)
    if health != "ok":
        raise RuntimeError("Solana RPC health check failed")
    slot = rpc_call(safe_url, "getSlot", [], timeout)
    version = rpc_call(safe_url, "getVersion", [], timeout)
    genesis_hash = rpc_call(safe_url, "getGenesisHash", [], timeout)
    if not isinstance(slot, int) or not isinstance(version, dict) or not isinstance(genesis_hash, str):
        raise RuntimeError("Solana RPC returned an unexpected status shape")
    return {
        "ok": True,
        "slot": slot,
        "version": str(version.get("solana-core", version.get("feature-set", "unknown"))),
        "genesis_hash": genesis_hash,
        "latency_ms": round((time.monotonic() - started) * 1000),
    }


def hedera_network_config(network: str) -> dict[str, str]:
    if network not in HEDERA_NETWORKS:
        raise RuntimeError("Hedera network must be mainnet, testnet, or previewnet")
    selected = dict(HEDERA_NETWORKS[network])
    test_base = os.environ.get("LCW3_HEDERA_TEST_BASE_URL", "")
    if test_base and os.environ.get("LCW3_TESTING") == "1":
        selected["mirror_url"] = validate_public_rpc_url(test_base, allow_local=True).rstrip("/")
    return selected


def hedera_current_network(config: dict[str, Any] | None = None) -> str:
    current = config if config is not None else load_config()
    hedera = current.get("hedera", {})
    if not isinstance(hedera, dict):
        raise RuntimeError("Hedera configuration must be a JSON object")
    network = str(hedera.get("network", "testnet")).lower()
    hedera_network_config(network)
    return network


def rest_get_json(base: str, path: str, timeout: float, query: dict[str, str] | None = None) -> dict[str, Any]:
    if not path.startswith("/") or ".." in path:
        raise RuntimeError("unsafe Mirror Node API path")
    url = base.rstrip("/") + path
    if query:
        url += "?" + urllib.parse.urlencode(query)
    request = urllib.request.Request(
        url,
        method="GET",
        headers={"Accept": "application/json", "User-Agent": "limechain-web3/0.1"},
    )
    try:
        opener = urllib.request.build_opener(_NoRedirectHandler())
        with opener.open(request, timeout=timeout) as response:
            if response.length is not None and response.length > 1_048_576:
                raise RuntimeError("Mirror Node response exceeded the 1 MiB limit")
            body = response.read(1_048_577)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise RuntimeError(f"Mirror Node unavailable: {exc.__class__.__name__}") from exc
    if len(body) > 1_048_576:
        raise RuntimeError("Mirror Node response exceeded the 1 MiB limit")
    try:
        decoded = json.loads(body)
    except json.JSONDecodeError as exc:
        raise RuntimeError("Mirror Node returned invalid JSON") from exc
    if not isinstance(decoded, dict):
        raise RuntimeError("Mirror Node returned an unexpected response")
    return decoded


def hedera_snapshot(network: str, timeout: float) -> dict[str, Any]:
    selected = hedera_network_config(network)
    started = time.monotonic()
    blocks = rest_get_json(
        selected["mirror_url"],
        "/blocks",
        timeout,
        {"limit": "1", "order": "desc"},
    )
    nodes = rest_get_json(
        selected["mirror_url"],
        "/network/nodes",
        timeout,
        {"limit": "100", "order": "asc"},
    )
    block_items = blocks.get("blocks")
    node_items = nodes.get("nodes")
    if not isinstance(block_items, list) or not block_items or not isinstance(block_items[0], dict):
        raise RuntimeError("Mirror Node returned no latest block")
    if not isinstance(node_items, list):
        raise RuntimeError("Mirror Node returned an unexpected node list")
    latest = block_items[0]
    block_height = latest.get("number")
    timestamp = latest.get("timestamp", {})
    if not isinstance(block_height, int) or not isinstance(timestamp, dict):
        raise RuntimeError("Mirror Node returned an unexpected block shape")
    return {
        "ok": True,
        "network": network,
        "mirror_url": selected["mirror_url"],
        "explorer_url": selected["explorer_url"],
        "block_height": block_height,
        "consensus_timestamp": str(timestamp.get("to") or timestamp.get("from") or ""),
        "hapi_version": str(latest.get("hapi_version") or ""),
        "node_count": len(node_items),
        "node_count_truncated": bool(nodes.get("links", {}).get("next")) if isinstance(nodes.get("links"), dict) else False,
        "latency_ms": round((time.monotonic() - started) * 1000),
    }


def inactive_snapshot(reason: str) -> dict[str, Any]:
    return {
        "ok": False,
        "chain_id": None,
        "block_height": None,
        "gas_gwei": None,
        "base_fee_gwei": None,
        "latency_ms": None,
        "error": reason,
    }


def inactive_solana_snapshot(reason: str) -> dict[str, Any]:
    return {
        "ok": False,
        "slot": None,
        "version": None,
        "genesis_hash": None,
        "latency_ms": None,
        "error": reason,
    }


def inactive_hedera_snapshot(reason: str, network: str = "testnet") -> dict[str, Any]:
    selected = hedera_network_config(network)
    return {
        "ok": False,
        "network": network,
        "mirror_url": selected["mirror_url"],
        "explorer_url": selected["explorer_url"],
        "block_height": None,
        "consensus_timestamp": None,
        "hapi_version": None,
        "node_count": None,
        "node_count_truncated": False,
        "latency_ms": None,
        "error": reason,
    }


def systemctl(*args: str, check: bool = False) -> subprocess.CompletedProcess[str]:
    if not shutil.which("systemctl"):
        return subprocess.CompletedProcess(["systemctl", *args], 127, "", "systemctl unavailable")
    return subprocess.run(
        ["systemctl", "--user", *args],
        check=check,
        capture_output=True,
        text=True,
        timeout=10,
    )


def anvil_service_active() -> bool:
    return systemctl("is-active", "--quiet", "limechain-web3-anvil.service").returncode == 0


def surfpool_service_active() -> bool:
    return systemctl("is-active", "--quiet", "limechain-web3-surfpool.service").returncode == 0


def command_status(args: argparse.Namespace) -> int:
    config = load_config()
    timeout = float(config.get("telemetry", {}).get("timeout_seconds", 3))
    timeout = min(10.0, max(0.5, timeout))
    chain = config.get("chain", {})
    local = config.get("local", {})
    profiles = installed_profiles()
    evm_installed = (
        "evm-core" in profiles
        or (raw_bin_dir() / "anvil").is_file()
        or systemd_unit_path().is_file()
    )

    remote_url = str(chain.get("rpc_url", "")).strip()
    if remote_url:
        try:
            remote = rpc_snapshot(remote_url, timeout, local=False)
        except RuntimeError as exc:
            remote = inactive_snapshot(str(exc))
    else:
        remote = inactive_snapshot("remote RPC not configured")

    local_url = str(local.get("rpc_url", "http://127.0.0.1:8545")).strip()
    if evm_installed:
        try:
            local_report = rpc_snapshot(local_url, timeout, local=True)
        except RuntimeError as exc:
            local_report = inactive_snapshot(str(exc))
    else:
        local_report = inactive_snapshot("evm-core profile not installed")

    solana_installed = (
        "solana-core" in profiles
        or (raw_bin_dir() / "surfpool").is_file()
        or surfpool_systemd_unit_path().is_file()
    )
    solana = config.get("solana", {}).get("local", {})
    solana_url = str(solana.get("rpc_url", "http://127.0.0.1:8899")).strip()
    if solana_installed:
        try:
            solana_report = solana_rpc_snapshot(solana_url, timeout)
        except RuntimeError as exc:
            solana_report = inactive_solana_snapshot(str(exc))
    else:
        solana_report = inactive_solana_snapshot("solana-core profile not installed")

    hedera_installed = "hedera-core" in profiles
    hedera_config_error = ""
    try:
        hedera_network = hedera_current_network(config)
    except RuntimeError as exc:
        hedera_network = "testnet"
        hedera_config_error = str(exc)
    if hedera_installed and hedera_config_error:
        hedera_report = inactive_hedera_snapshot(hedera_config_error, hedera_network)
    elif hedera_installed:
        try:
            hedera_report = hedera_snapshot(hedera_network, timeout)
        except RuntimeError as exc:
            hedera_report = inactive_hedera_snapshot(str(exc), hedera_network)
    else:
        hedera_report = inactive_hedera_snapshot("hedera-core profile not installed", hedera_network)

    report = {
        "schema": 3,
        "chain": {
            "configured": bool(remote_url),
            "name": str(chain.get("name", "Unconfigured")),
            "expected_chain_id": chain.get("chain_id"),
            "explorer_url": str(chain.get("explorer_url", "")),
            **remote,
        },
        "local": {
            "installed": evm_installed,
            "expected_chain_id": local.get("chain_id", 31337),
            "service_active": anvil_service_active() if evm_installed else False,
            **local_report,
        },
        "solana": {
            "installed": solana_installed,
            "service_active": surfpool_service_active() if solana_installed else False,
            "rpc_url": solana_url,
            "mode": "offline",
            "surfpool_version": locked_artifact_version("surfpool") or None,
            "cli_version": locked_artifact_version("agave") or None,
            "anchor_version": locked_artifact_version("anchor") or None,
            **solana_report,
        },
        "hedera": {
            "installed": hedera_installed,
            "mode": "read-only",
            **hedera_report,
        },
    }
    if args.json:
        print(json_dump(report))
    else:
        chain_report = report["chain"]
        local_status = "healthy" if report["local"]["ok"] else "offline"
        solana_status = "healthy" if report["solana"]["ok"] else "offline"
        local_summary = f"Anvil {local_status}" if evm_installed else ""
        if report["solana"]["installed"]:
            local_summary += (", " if local_summary else "") + f"Surfpool {solana_status}"
        if report["hedera"]["installed"]:
            hedera_status = "healthy" if report["hedera"]["ok"] else "offline"
            local_summary += (", " if local_summary else "") + f"Hedera {hedera_network} {hedera_status}"
        local_summary = local_summary or "no network profile installed"
        if hedera_installed and not evm_installed and not solana_installed and not chain_report["configured"]:
            if report["hedera"]["ok"]:
                print(
                    f"Hedera {hedera_network}: block {report['hedera']['block_height']:,}, "
                    f"{report['hedera']['node_count']} consensus nodes"
                )
            else:
                print(f"Hedera {hedera_network}: {report['hedera']['error']}")
        elif chain_report["ok"]:
            print(
                f"{chain_report['name']}: block {chain_report['block_height']:,}, "
                f"gas {chain_report['gas_gwei']} gwei; {local_summary}"
            )
        else:
            print(f"{chain_report['name']}: {chain_report['error']}; {local_summary}")
    return 0


def command_remote_guide(args: argparse.Namespace) -> int:
    print("Remote observer setup (optional)")
    print("================================")
    print("The local Anvil controls do not need a remote RPC.")
    print("A remote RPC adds read-only block, gas, fee, and explorer status.")
    print("Use a public endpoint with no credentials, query string, or URL fragment:")
    print()
    print("limechain-web3 configure \\")
    print("  --name Sepolia \\")
    print("  --chain-id 11155111 \\")
    print("  --rpc-url https://YOUR-CREDENTIAL-FREE-PUBLIC-RPC \\")
    print("  --explorer-url https://sepolia.etherscan.io")
    print()
    print("Remove remote configuration with: limechain-web3 configure --clear")
    if args.wait and sys.stdin.isatty():
        input("Press Enter to close...")
    return 0


def secret_paths(value: Any, prefix: str = "") -> list[str]:
    findings: list[str] = []
    if isinstance(value, dict):
        for key, child in value.items():
            path = f"{prefix}.{key}" if prefix else str(key)
            if SENSITIVE_KEY.search(str(key)):
                findings.append(path)
            findings.extend(secret_paths(child, path))
    elif isinstance(value, list):
        for index, child in enumerate(value):
            findings.extend(secret_paths(child, f"{prefix}[{index}]"))
    return findings


def _tool_version(path: Path) -> str:
    try:
        completed = subprocess.run(
            [str(path), "--version"], capture_output=True, text=True, timeout=5, env=sanitized_env()
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if completed.returncode != 0:
        return ""
    return " | ".join((completed.stdout or completed.stderr).strip().splitlines())


def _python_package_version(distribution: str) -> str:
    python = app_root() / "python" / "bin" / "python"
    try:
        completed = subprocess.run(
            [str(python), "-c", "import importlib.metadata,sys; print(importlib.metadata.version(sys.argv[1]))", distribution],
            capture_output=True,
            text=True,
            timeout=5,
            env=sanitized_env(),
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return completed.stdout.strip() if completed.returncode == 0 else ""


def verify_tree_manifest(root: Path) -> tuple[bool, str]:
    manifest = root / ".limechain-files.sha256"
    if not manifest.is_file():
        return False, "file manifest missing"
    try:
        for line in manifest.read_text(encoding="utf-8").splitlines():
            digest, relative = line.split(maxsplit=1)
            relative = relative.lstrip("* ")
            target = (root / relative).resolve()
            if root.resolve() not in target.parents and target != root.resolve():
                return False, f"unsafe manifest path: {relative}"
            if not target.is_file():
                return False, f"missing: {relative}"
            hasher = hashlib.sha256()
            with target.open("rb") as stream:
                while chunk := stream.read(1024 * 1024):
                    hasher.update(chunk)
            if hasher.hexdigest() != digest:
                return False, f"modified: {relative}"
    except (OSError, ValueError) as exc:
        return False, f"manifest error: {exc}"
    return True, "verified"


def command_doctor(args: argparse.Namespace) -> int:
    checks: list[dict[str, Any]] = []

    def add(name: str, ok: bool, detail: str) -> None:
        checks.append({"name": name, "ok": ok, "detail": detail})

    add("linux", sys.platform.startswith("linux"), sys.platform)
    omarchy = shutil.which("omarchy")
    add("omarchy-cli", bool(omarchy), omarchy or "not found")
    if shutil.which("pacman"):
        result = subprocess.run(["pacman", "-Q", "omarchy"], capture_output=True, text=True, timeout=5)
        package = result.stdout.strip()
        add("omarchy-quattro", result.returncode == 0 and re.search(r"\s4\.", package) is not None, package or "not installed")
    else:
        add("omarchy-quattro", False, "pacman unavailable")

    try:
        config = load_config()
        secrets = secret_paths(config)
        mode = stat.S_IMODE(config_path().stat().st_mode)
        add("config", not secrets and mode & 0o077 == 0, f"mode={mode:o}; sensitive fields={secrets or 'none'}")
    except (RuntimeError, OSError) as exc:
        add("config", False, str(exc))

    expected: dict[str, str] = {}
    profiles: set[str] = set()
    for current_lock_path in lock_paths():
        try:
            lock = read_json(current_lock_path)
            profile = str(lock.get("profile", "unknown"))
            profiles.add(profile)
            for artifact in lock.get("artifacts", []):
                artifact_root = (
                    app_root()
                    / "toolchains"
                    / "installed"
                    / str(artifact.get("id"))
                    / str(artifact.get("version"))
                )
                tree_ok, tree_detail = verify_tree_manifest(artifact_root)
                add(f"artifact:{artifact.get('id')}", tree_ok, tree_detail)
                for tool in artifact.get("bins", {}):
                    expected[tool] = str(artifact.get("version", ""))
            for tool, version in lock.get("python", {}).get("packages", {}).items():
                expected[str(tool)] = str(version)
        except RuntimeError as exc:
            add(f"lockfile:{current_lock_path.stem}", False, str(exc))
        else:
            add(f"lockfile:{profile}", True, str(current_lock_path))

    for tool, version in sorted(expected.items()):
        path = raw_bin_dir() / tool
        actual = _python_package_version("solc-select") if tool == "solc-select" and path.is_file() else _tool_version(path) if path.is_file() else ""
        independently_versioned = tool in {"corepack", "npm", "npx", "cargo", "rustc", "cargo-build-sbf"}
        version_ok = bool(actual) and (independently_versioned or not version or version.lstrip("v") in actual)
        add(f"tool:{tool}", version_ok, actual or "missing")

    if "evm-core" in profiles:
        add("anvil-unit", systemd_unit_path().is_file(), str(systemd_unit_path()))
    if "solana-core" in profiles:
        add("surfpool-unit", surfpool_systemd_unit_path().is_file(), str(surfpool_systemd_unit_path()))
    add("shell-plugin", (config_home() / "omarchy" / "plugins" / APP_ID / "manifest.json").is_file(), APP_ID)
    add("agent-skill", (_home() / ".agents" / "skills" / "limechain-web3" / "SKILL.md").is_file(), "limechain-web3")

    ok = all(item["ok"] for item in checks)
    report = {"ok": ok, "checks": checks}
    if args.json:
        print(json_dump(report))
    else:
        for item in checks:
            print(f"{'ok' if item['ok'] else 'FAIL':<4} {item['name']}: {item['detail']}")
    return 0 if ok else 1


def command_configure(args: argparse.Namespace) -> int:
    config = load_config()
    chain = config.setdefault("chain", {})
    if args.clear:
        chain.update({"name": "Unconfigured", "chain_id": None, "rpc_url": "", "explorer_url": ""})
    else:
        chain["name"] = args.name
        chain["chain_id"] = args.chain_id
        chain["rpc_url"] = validate_public_rpc_url(args.rpc_url)
        chain["explorer_url"] = validate_explorer_url(args.explorer_url)
    if secret_paths(config):
        raise RuntimeError("configuration contains a sensitive-looking field and was not written")
    write_config(config)
    print(f"Updated {config_path()}")
    return 0


def require_hedera_profile() -> None:
    if "hedera-core" not in installed_profiles():
        raise RuntimeError("hedera-core profile is not installed")


def hedera_query(
    path: str,
    *,
    timeout: float | None = None,
    query: dict[str, str] | None = None,
) -> dict[str, Any]:
    config = load_config()
    network = hedera_current_network(config)
    selected = hedera_network_config(network)
    configured_timeout = float(config.get("telemetry", {}).get("timeout_seconds", 3))
    return rest_get_json(
        selected["mirror_url"],
        path,
        min(10.0, max(0.5, timeout if timeout is not None else configured_timeout)),
        query,
    )


def command_hedera(args: argparse.Namespace) -> int:
    require_hedera_profile()
    config = load_config()
    network = hedera_current_network(config)
    timeout = min(10.0, max(0.5, float(config.get("telemetry", {}).get("timeout_seconds", 3))))

    if args.hedera_action == "network":
        if args.name is None:
            print(network)
            return 0
        hedera_network_config(args.name)
        hedera = config.setdefault("hedera", {})
        if not isinstance(hedera, dict):
            raise RuntimeError("Hedera configuration must be a JSON object")
        hedera["network"] = args.name
        if secret_paths(config):
            raise RuntimeError("configuration contains a sensitive-looking field and was not written")
        write_config(config)
        print(f"Hedera observer now uses {args.name}")
        return 0

    if args.hedera_action in {"status", "latest-block", "open-latest"}:
        report = hedera_snapshot(network, timeout)
        if args.hedera_action == "status":
            if args.json:
                print(json_dump(report))
            else:
                print(
                    f"Hedera {network}: block {report['block_height']:,}, "
                    f"{report['node_count']}{'+' if report['node_count_truncated'] else ''} consensus nodes, "
                    f"{report['latency_ms']} ms"
                )
            return 0
        if args.hedera_action == "latest-block":
            print(report["block_height"])
            return 0
        target = f"{report['explorer_url']}/block/{report['block_height']}"
        subprocess.run(["xdg-open", target], check=True, timeout=10)
        return 0

    if args.hedera_action == "nodes":
        response = hedera_query("/network/nodes", query={"limit": "100", "order": "asc"})
        raw_nodes = response.get("nodes")
        if not isinstance(raw_nodes, list):
            raise RuntimeError("Mirror Node returned an unexpected node list")
        nodes = [
            {
                "node_id": item.get("node_id"),
                "account_id": item.get("node_account_id"),
                "description": item.get("description"),
                "service_endpoints": item.get("service_endpoints", []),
            }
            for item in raw_nodes
            if isinstance(item, dict)
        ]
        if args.json:
            print(json_dump({"network": network, "nodes": nodes}))
        else:
            for item in nodes:
                print(f"{item['node_id']}\t{item['account_id']}\t{item['description'] or ''}")
        return 0

    if args.hedera_action == "account":
        if not HEDERA_ACCOUNT.fullmatch(args.identifier):
            raise RuntimeError("Hedera account must be 0.0.N or a 20-byte EVM address")
        response = hedera_query("/accounts/" + urllib.parse.quote(args.identifier, safe="."))
        balance = response.get("balance", {})
        result = {
            "network": network,
            "account": response.get("account"),
            "balance_tinybar": balance.get("balance") if isinstance(balance, dict) else None,
            "deleted": response.get("deleted"),
            "ethereum_nonce": response.get("ethereum_nonce"),
            "memo": response.get("memo"),
        }
        print(json_dump(result) if args.json else "\n".join(f"{key}: {value}" for key, value in result.items()))
        return 0

    if args.hedera_action == "transaction":
        if not HEDERA_TRANSACTION.fullmatch(args.identifier):
            raise RuntimeError("Hedera transaction ID must use 0.0.N@seconds.nanoseconds")
        response = hedera_query("/transactions/" + urllib.parse.quote(args.identifier, safe=".@-"))
        transactions = response.get("transactions")
        if not isinstance(transactions, list):
            raise RuntimeError("Mirror Node returned an unexpected transaction response")
        result = {
            "network": network,
            "transactions": [
                {
                    "transaction_id": item.get("transaction_id"),
                    "consensus_timestamp": item.get("consensus_timestamp"),
                    "result": item.get("result"),
                    "name": item.get("name"),
                    "charged_tx_fee": item.get("charged_tx_fee"),
                    "node": item.get("node"),
                }
                for item in transactions
                if isinstance(item, dict)
            ],
        }
        print(json_dump(result) if args.json else "\n".join(json_dump(item) for item in result["transactions"]))
        return 0

    raise RuntimeError("unsupported Hedera action")


def command_anvil(args: argparse.Namespace) -> int:
    if args.action == "status":
        active = anvil_service_active()
        print("active" if active else "inactive")
        return 0 if active else 3
    if not systemd_unit_path().is_file():
        raise RuntimeError(f"Anvil service is not installed: {systemd_unit_path()}")
    action = "restart" if args.action == "reset" else args.action
    result = systemctl(action, "limechain-web3-anvil.service")
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout).strip() or f"systemctl {action} failed")
    print(f"Anvil {args.action} complete")
    return 0


def command_surfpool(args: argparse.Namespace) -> int:
    if args.action == "status":
        active = surfpool_service_active()
        print("active" if active else "inactive")
        return 0 if active else 3
    if not surfpool_systemd_unit_path().is_file():
        raise RuntimeError(f"Surfpool service is not installed: {surfpool_systemd_unit_path()}")
    if not (raw_bin_dir() / "surfpool").is_file():
        raise RuntimeError("verified Surfpool binary is not installed")
    action = "restart" if args.action == "reset" else args.action
    result = systemctl(action, "limechain-web3-surfpool.service")
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout).strip() or f"systemctl {action} failed")
    print(f"Surfpool {args.action} complete")
    return 0


def command_fork(args: argparse.Namespace) -> int:
    url = validate_public_rpc_url(args.rpc_url, resolve=True)
    anvil = raw_bin_dir() / "anvil"
    if not anvil.is_file():
        raise RuntimeError("verified Anvil binary is not installed")
    argv = [
        str(anvil),
        "--fork-url",
        url,
        "--host",
        "127.0.0.1",
        "--port",
        str(args.port),
        "--chain-id",
        str(args.chain_id),
        "--accounts",
        "0",
        "--silent",
    ]
    os.execve(str(anvil), argv, sanitized_env())


def command_scaffold(args: argparse.Namespace) -> int:
    source = sample_root()
    target = Path(args.directory).expanduser().resolve()
    if not source.is_dir():
        raise RuntimeError(f"sample project is not installed: {source}")
    if target.exists():
        raise RuntimeError(f"refusing to overwrite existing path: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source, target)
    print(f"Created {target}")
    return 0


def command_anchor_scaffold(args: argparse.Namespace) -> int:
    source = anchor_sample_root()
    target = Path(args.directory).expanduser().resolve()
    if not source.is_dir():
        raise RuntimeError(f"Anchor sample project is not installed: {source}")
    if target.exists():
        raise RuntimeError(f"refusing to overwrite existing path: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source, target)
    print(f"Created safe keypair-free Anchor sample at {target}")
    return 0


def isolated_solana_env(*, build: bool = False) -> dict[str, str]:
    home = solana_home()
    cargo_home = home / ".cargo"
    home.mkdir(parents=True, exist_ok=True, mode=0o700)
    cargo_home.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(home, 0o700)
    os.chmod(cargo_home, 0o700)

    env = {key: value for key, value in os.environ.items() if key in {"LANG", "LC_ALL", "TERM", "TMPDIR"}}
    env.update(
        {
            "HOME": str(home),
            "CARGO_HOME": str(cargo_home),
            "XDG_CACHE_HOME": str(home / ".cache"),
            "XDG_CONFIG_HOME": str(home / ".config"),
            "XDG_DATA_HOME": str(home / ".local" / "share"),
            "XDG_STATE_HOME": str(home / ".local" / "state"),
        }
    )
    for key in ("XDG_CACHE_HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME"):
        Path(env[key]).mkdir(parents=True, exist_ok=True, mode=0o700)

    if build:
        safe_bin = home / "build-bin"
        safe_bin.mkdir(parents=True, exist_ok=True, mode=0o700)
        for command in ("cargo", "rustc", "cargo-build-sbf"):
            source = raw_bin_dir() / command
            if not source.is_file():
                raise RuntimeError(f"verified Solana build tool is missing: {source}")
            target = safe_bin / command
            if target.is_symlink() or target.exists():
                target.unlink()
            target.symlink_to(source)
        env["PATH"] = os.pathsep.join([str(safe_bin), "/usr/local/bin", "/usr/bin", "/bin"])
        env["CARGO_NET_GIT_FETCH_WITH_CLI"] = "false"
    else:
        env["PATH"] = os.pathsep.join(["/usr/local/bin", "/usr/bin", "/bin"])
    return env


def command_solana(args: argparse.Namespace) -> int:
    solana = raw_bin_dir() / "solana"
    if not solana.is_file() or not os.access(solana, os.X_OK):
        raise RuntimeError("verified Solana CLI is not installed")
    if args.action == "version":
        argv = [str(solana), "--version"]
    else:
        config = load_config()
        rpc_url = str(config.get("solana", {}).get("local", {}).get("rpc_url", "http://127.0.0.1:8899"))
        rpc_url = validate_public_rpc_url(rpc_url, allow_local=True)
        command = {
            "slot": "slot",
            "epoch": "epoch-info",
            "block-height": "block-height",
            "genesis-hash": "genesis-hash",
            "transaction-count": "transaction-count",
            "cluster-version": "cluster-version",
        }[args.action]
        argv = [str(solana), "--url", rpc_url, command]
    return subprocess.run(argv, env=isolated_solana_env()).returncode


def anchor_build_preflight(root: Path) -> list[str]:
    root = root.resolve()
    anchor_toml = root / "Anchor.toml"
    cargo_toml = root / "Cargo.toml"
    cargo_lock = root / "Cargo.lock"
    for path in (anchor_toml, cargo_toml, cargo_lock):
        if not path.is_file():
            raise RuntimeError(f"safe Anchor build requires {path.name} at the workspace root")
    try:
        config = tomllib.loads(anchor_toml.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise RuntimeError(f"could not validate Anchor.toml: {exc}") from exc

    hooks = config.get("hooks", {})
    if isinstance(hooks, dict) and any(hooks.get(name) for name in ("pre_build", "pre-build", "post_build", "post-build")):
        raise RuntimeError("Anchor build hooks are refused because they execute arbitrary shell commands")
    clients = config.get("clients", {})
    if isinstance(clients, dict) and clients.get("auto") is True:
        raise RuntimeError("automatic client generation is refused in the guarded Anchor build")
    toolchain = config.get("toolchain", {})
    if isinstance(toolchain, dict):
        anchor_version = toolchain.get("anchor_version")
        if anchor_version not in (None, locked_artifact_version("anchor")):
            raise RuntimeError("Anchor.toml requests an unreviewed Anchor version")
        if toolchain.get("solana_version") is not None:
            raise RuntimeError("omit toolchain.solana_version; the guarded build injects the pinned SBF toolchain")
    provider = config.get("provider", {})
    if not isinstance(provider, dict) or str(provider.get("cluster", "")).lower() != "localnet":
        raise RuntimeError("safe Anchor build requires provider.cluster = \"Localnet\"")
    if provider.get("wallet") != "/dev/null":
        raise RuntimeError("safe Anchor build requires provider.wallet = \"/dev/null\"")
    deploy_dir = root / "target" / "deploy"
    if deploy_dir.is_dir() and any(deploy_dir.glob("*-keypair.json")):
        raise RuntimeError("program keypair files are present; move them outside the workspace before using the guarded build")

    try:
        workspace_manifest = tomllib.loads(cargo_toml.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise RuntimeError(f"could not validate workspace Cargo.toml: {exc}") from exc
    workspace = workspace_manifest.get("workspace", {})
    members = workspace.get("members", []) if isinstance(workspace, dict) else []
    if not isinstance(members, list) or not members:
        raise RuntimeError("safe Anchor build requires explicit Cargo workspace members")
    program_names: list[str] = []
    for member in members:
        if not isinstance(member, str) or not member or any(character in member for character in "*?["):
            raise RuntimeError("safe Anchor build does not accept wildcard Cargo workspace members")
        member_root = (root / member).resolve()
        if root not in member_root.parents:
            raise RuntimeError("Cargo workspace member escapes the Anchor workspace")
        member_manifest_path = member_root / "Cargo.toml"
        try:
            member_manifest = tomllib.loads(member_manifest_path.read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError) as exc:
            raise RuntimeError(f"could not validate {member_manifest_path}: {exc}") from exc
        lib = member_manifest.get("lib", {})
        crate_types = lib.get("crate-type", []) if isinstance(lib, dict) else []
        if "cdylib" not in crate_types:
            continue
        package = member_manifest.get("package", {})
        package_name = package.get("name", "") if isinstance(package, dict) else ""
        program_name = str(lib.get("name") or package_name).replace("-", "_")
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", program_name):
            raise RuntimeError(f"unsafe or missing Anchor program name in {member_manifest_path}")
        program_names.append(program_name)
    if not program_names:
        raise RuntimeError("safe Anchor build found no explicit cdylib program members")
    return sorted(set(program_names))


def command_anchor_build(args: argparse.Namespace) -> int:
    anchor = raw_bin_dir() / "anchor"
    if not anchor.is_file() or not os.access(anchor, os.X_OK):
        raise RuntimeError("verified Anchor CLI is not installed")
    root = Path(args.directory).expanduser().resolve()
    if not root.is_dir():
        raise RuntimeError(f"Anchor workspace does not exist: {root}")
    program_names = anchor_build_preflight(root)
    platform_tools_version = locked_artifact_version("platform-tools")
    if not platform_tools_version:
        raise RuntimeError("pinned Solana platform-tools version is unavailable")
    if platform_tools_version != "1.52":
        raise RuntimeError("Anchor 1.1.2 requires the reviewed SBF platform-tools 1.52")
    cargo_build_sbf_args = ["--no-rustup-override", "--skip-tools-install"]
    if args.offline:
        cargo_build_sbf_args.append("--offline")
    argv = [
        str(anchor),
        "build",
        "--ignore-keys",
        "--no-idl",
        "--",
        *cargo_build_sbf_args,
        "--",
        "--locked",
    ]
    env = isolated_solana_env(build=True)
    env["CARGO_TARGET_DIR"] = str(root / "target")
    deploy_dir = root / "target" / "deploy"
    deploy_dir.mkdir(parents=True, exist_ok=True)
    sentinels = [deploy_dir / f"{program_name}-keypair.json" for program_name in program_names]
    for sentinel in sentinels:
        if os.path.lexists(sentinel):
            raise RuntimeError(f"refusing to replace an existing program keypair path: {sentinel}")
        sentinel.symlink_to("/dev/null")
    try:
        return subprocess.run(argv, cwd=root, env=env).returncode
    finally:
        for sentinel in sentinels:
            if os.path.lexists(sentinel):
                sentinel.unlink()


def command_anchor_version(_args: argparse.Namespace) -> int:
    anchor = raw_bin_dir() / "anchor"
    if not anchor.is_file() or not os.access(anchor, os.X_OK):
        raise RuntimeError("verified Anchor CLI is not installed")
    return subprocess.run([str(anchor), "--version"], env=isolated_solana_env()).returncode


def dangerous_tool_invocation(tool: str, argv: list[str]) -> str | None:
    lowered = [part.lower() for part in argv]
    sensitive_flags = {
        "--private-key",
        "--mnemonic",
        "--keystore",
        "--password",
        "--aws",
        "--keypair",
        "--airdrop-keypair-path",
        "--payer",
        "--secret-key",
    }
    if any(part in sensitive_flags or any(part.startswith(flag + "=") for flag in sensitive_flags) for part in lowered):
        return "credential and signing flags are outside this workstation's boundary"
    rpc_flags = {"--rpc-url", "--eth-rpc-url", "--fork-url"}
    for index, part in enumerate(lowered):
        value = ""
        if part in rpc_flags and index + 1 < len(argv):
            value = argv[index + 1]
        else:
            for flag in rpc_flags:
                if part.startswith(flag + "="):
                    value = argv[index][len(flag) + 1 :]
                    break
        if value:
            try:
                validate_public_rpc_url(value, allow_local=True)
            except RuntimeError:
                try:
                    validate_public_rpc_url(value, resolve=True)
                except RuntimeError as exc:
                    return str(exc)
    if tool == "cast":
        blocked_commands = {"send", "publish", "mktx", "wallet"}
        command = next((part for part in lowered if part in blocked_commands), "")
        if command:
            return f"cast {command} can sign or submit transactions"
        if "rpc" in lowered and any(re.match(r"(eth_send|personal_|wallet_)", part) for part in lowered):
            return "transaction and wallet JSON-RPC methods are refused"
    if tool == "forge":
        if "create" in lowered or "--broadcast" in lowered:
            return "deployment and broadcast operations are refused"
    return None


def sanitized_env() -> dict[str, str]:
    keep = {"HOME", "LANG", "LC_ALL", "PATH", "TERM", "TMPDIR", "XDG_RUNTIME_DIR"}
    env = {key: value for key, value in os.environ.items() if key in keep}
    env["PATH"] = os.pathsep.join([str(env_bin_dir()), "/usr/local/bin", "/usr/bin", "/bin"])
    env.pop("ETH_FROM", None)
    return env


def command_exec(args: argparse.Namespace) -> int:
    tool = args.tool
    if tool == "anvil":
        if args.tool_args:
            raise RuntimeError("use 'limechain-web3 anvil' or 'limechain-web3 fork'; arbitrary Anvil flags are refused")
        raw = raw_bin_dir() / "anvil"
        argv = [str(raw), "--host", "127.0.0.1", "--accounts", "0", "--silent"]
    elif tool == "surfpool":
        if args.tool_args not in (["--version"], ["--help"], ["start", "--help"]):
            raise RuntimeError(
                "use 'limechain-web3 surfpool' for the fixed offline service; "
                "arbitrary Surfpool commands are refused"
            )
        raw = raw_bin_dir() / "surfpool"
        argv = [str(raw), *args.tool_args]
    elif tool in {"solana", "anchor", "cargo", "rustc", "cargo-build-sbf"}:
        allowed = (["--version"], ["--help"])
        if args.tool_args not in allowed and not (tool == "anchor" and args.tool_args == ["build", "--help"]):
            raise RuntimeError(
                f"arbitrary {tool} commands are refused; use the fixed 'solana' or 'anchor' workstation commands"
            )
        raw = raw_bin_dir() / tool
        argv = [str(raw), *args.tool_args]
    else:
        reason = dangerous_tool_invocation(tool, args.tool_args)
        if reason:
            raise RuntimeError(reason)
        raw = raw_bin_dir() / tool
        argv = [str(raw), *args.tool_args]
    if not raw.is_file() or not os.access(raw, os.X_OK):
        raise RuntimeError(f"verified tool is missing: {raw}")
    completed = subprocess.run(argv, env=sanitized_env())
    return completed.returncode


def command_shell(args: argparse.Namespace) -> int:
    shell = os.environ.get("SHELL", "/bin/zsh")
    if not Path(shell).is_file():
        shell = "/bin/bash"
    env = sanitized_env()
    profiles = installed_profiles()
    env["LIMECHAIN_WEB3_ENV"] = ",".join(profiles)
    print(
        f"Entering verified {' + '.join(profiles)} shell. "
        "Signing, broadcast, and arbitrary runtime commands remain blocked."
    )
    return subprocess.run([shell, "-l"], env=env).returncode


def command_open_explorer(args: argparse.Namespace) -> int:
    config = load_config()
    base = validate_explorer_url(str(config.get("chain", {}).get("explorer_url", "")))
    if not base:
        raise RuntimeError("explorer URL is not configured")
    target = base
    if args.kind and args.value:
        if args.kind == "block" and not re.fullmatch(r"[0-9]+", args.value):
            raise RuntimeError("block must be a decimal number")
        if args.kind in {"tx", "address"} and not re.fullmatch(r"0x[0-9a-fA-F]{40,64}", args.value):
            raise RuntimeError(f"invalid {args.kind} value")
        target = f"{base}/{args.kind}/{args.value}"
    subprocess.run(["xdg-open", target], check=True, timeout=10)
    return 0


def _strip_jsonc_comments(text: str) -> str:
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    return re.sub(r"//[^\n]*", "", text)


def install_menu_extension() -> None:
    path = menu_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and MENU_BEGIN in path.read_text(encoding="utf-8"):
        remove_menu_extension()
    if path.exists():
        text = path.read_text(encoding="utf-8")
    else:
        text = "{\n}\n"
    close_index = text.rfind("}")
    if close_index < 0:
        raise RuntimeError(f"menu extension is not a JSONC object: {path}")
    before = text[:close_index]
    significant = _strip_jsonc_comments(before).rstrip()
    delimiter = "" if significant.endswith(("{", ",")) else ","
    entries = [
        f'{delimiter}"web3": {{"icon":"󰡪","label":"Web3 Workstation"}}',
        '"web3.status": {"icon":"󰄬","label":"Chain Status","action":"omarchy-shell shell toggle limechain.web3"}',
        '"web3.shell": {"icon":"","label":"Verified Web3 Shell","action":"omarchy-launch-floating-terminal-with-presentation \'limechain-web3 shell\'"}',
    ]
    profiles = installed_profiles()
    if "evm-core" in profiles:
        entries.extend(
            [
                '"web3.anvil-start": {"icon":"󰐊","label":"Start Local Anvil","action":"omarchy-launch-floating-terminal-with-presentation \'limechain-web3 anvil start\'"}',
                '"web3.anvil-stop": {"icon":"󰓛","label":"Stop Local Anvil","action":"omarchy-launch-floating-terminal-with-presentation \'limechain-web3 anvil stop\'"}',
            ]
        )
    if "solana-core" in profiles:
        entries.extend(
            [
                '"web3.surfpool-start": {"icon":"󰐊","label":"Start Offline Surfpool","action":"omarchy-launch-floating-terminal-with-presentation \'limechain-web3 surfpool start\'"}',
                '"web3.surfpool-stop": {"icon":"󰓛","label":"Stop Offline Surfpool","action":"omarchy-launch-floating-terminal-with-presentation \'limechain-web3 surfpool stop\'"}',
            ]
        )
    if "hedera-core" in profiles:
        entries.extend(
            [
                '"web3.hedera-status": {"icon":"󰄬","label":"Hedera Observer Status","action":"omarchy-launch-floating-terminal-with-presentation \'limechain-web3 hedera status; read -r\'"}',
                '"web3.hedera-explorer": {"icon":"󰖟","label":"Open Latest Hedera Block","action":"limechain-web3 hedera open-latest"}',
            ]
        )
    entries.append(
        '"web3.doctor": {"icon":"󰒓","label":"Run Workstation Doctor","action":"omarchy-launch-floating-terminal-with-presentation \'limechain-web3 doctor; read -r\'"}'
    )
    rendered_entries = ",\n".join(f"  {entry}" for entry in entries)
    block = f"  {MENU_BEGIN}\n{rendered_entries}\n  {MENU_END}\n"
    updated = before.rstrip() + "\n" + block + text[close_index:]
    atomic_write(path, updated, 0o600)


def remove_menu_extension() -> None:
    path = menu_path()
    if not path.exists():
        return
    text = path.read_text(encoding="utf-8")
    pattern = re.compile(
        r"\n?\s*" + re.escape(MENU_BEGIN) + r".*?" + re.escape(MENU_END) + r"\s*\n?",
        re.S,
    )
    updated, count = pattern.subn("\n", text, count=1)
    if count:
        atomic_write(path, updated, 0o600)


def command_internal(args: argparse.Namespace) -> int:
    if args.action == "install-menu":
        install_menu_extension()
    elif args.action == "remove-menu":
        remove_menu_extension()
    else:
        raise RuntimeError("unknown internal action")
    return 0


def command_lifecycle(args: argparse.Namespace) -> int:
    script = app_root() / "scripts" / ("update.sh" if args.action == "update" else "uninstall.sh")
    if not script.is_file():
        raise RuntimeError(f"lifecycle script is missing: {script}")
    extra = ["--purge"] if args.action == "uninstall" and args.purge else []
    return subprocess.run([str(script), *extra]).returncode


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="limechain-web3", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="read chain and local RPC health")
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=command_status)

    doctor = sub.add_parser("doctor", help="verify the installation and security boundary")
    doctor.add_argument("--json", action="store_true")
    doctor.set_defaults(func=command_doctor)

    configure = sub.add_parser("configure", help="configure a credential-free read-only RPC")
    configure.add_argument("--name", default="Ethereum")
    configure.add_argument("--chain-id", type=int)
    configure.add_argument("--rpc-url")
    configure.add_argument("--explorer-url", default="")
    configure.add_argument("--clear", action="store_true")
    configure.set_defaults(func=command_configure)

    remote_guide = sub.add_parser("remote-guide", help="explain optional read-only remote RPC setup")
    remote_guide.add_argument("--wait", action="store_true")
    remote_guide.set_defaults(func=command_remote_guide)

    anvil = sub.add_parser("anvil", help="control the fixed local Anvil user service")
    anvil.add_argument("action", choices=("start", "stop", "restart", "reset", "status"))
    anvil.set_defaults(func=command_anvil)

    surfpool = sub.add_parser("surfpool", help="control the fixed offline local Surfpool service")
    surfpool.add_argument("action", choices=("start", "stop", "restart", "reset", "status"))
    surfpool.set_defaults(func=command_surfpool)

    fork = sub.add_parser("fork", help="run a foreground, account-free fork from a public RPC URL")
    fork.add_argument("--rpc-url", required=True)
    fork.add_argument("--port", type=int, default=8545, choices=range(1024, 65536), metavar="PORT")
    fork.add_argument("--chain-id", type=int, default=31337)
    fork.set_defaults(func=command_fork)

    scaffold = sub.add_parser("scaffold", help="copy the bundled dependency-free Foundry sample")
    scaffold.add_argument("directory")
    scaffold.set_defaults(func=command_scaffold)

    solana = sub.add_parser("solana", help="run a fixed read-only Solana CLI query against local Surfpool")
    solana.add_argument(
        "action",
        choices=("version", "slot", "epoch", "block-height", "genesis-hash", "transaction-count", "cluster-version"),
    )
    solana.set_defaults(func=command_solana)

    hedera = sub.add_parser("hedera", help="use the fixed read-only Hedera Mirror Node observer")
    hedera_sub = hedera.add_subparsers(dest="hedera_action", required=True)
    hedera_status = hedera_sub.add_parser("status", help="show Mirror Node and consensus status")
    hedera_status.add_argument("--json", action="store_true")
    hedera_status.set_defaults(func=command_hedera)
    hedera_network = hedera_sub.add_parser("network", help="show or select an official Hedera network")
    hedera_network.add_argument("name", nargs="?", choices=tuple(HEDERA_NETWORKS))
    hedera_network.set_defaults(func=command_hedera)
    hedera_latest = hedera_sub.add_parser("latest-block", help="print the latest block number")
    hedera_latest.set_defaults(func=command_hedera)
    hedera_nodes = hedera_sub.add_parser("nodes", help="list consensus nodes")
    hedera_nodes.add_argument("--json", action="store_true")
    hedera_nodes.set_defaults(func=command_hedera)
    hedera_account = hedera_sub.add_parser("account", help="inspect an account without signing")
    hedera_account.add_argument("identifier")
    hedera_account.add_argument("--json", action="store_true")
    hedera_account.set_defaults(func=command_hedera)
    hedera_transaction = hedera_sub.add_parser("transaction", help="inspect a transaction by ID")
    hedera_transaction.add_argument("identifier")
    hedera_transaction.add_argument("--json", action="store_true")
    hedera_transaction.set_defaults(func=command_hedera)
    hedera_open = hedera_sub.add_parser("open-latest", help="open the latest block in HashScan")
    hedera_open.set_defaults(func=command_hedera)

    anchor = sub.add_parser("anchor", help="use the guarded, keypair-free Anchor workflow")
    anchor_sub = anchor.add_subparsers(dest="anchor_action", required=True)
    anchor_version = anchor_sub.add_parser("version", help="show the pinned Anchor CLI version")
    anchor_version.set_defaults(func=command_anchor_version)
    anchor_scaffold = anchor_sub.add_parser("scaffold", help="copy the bundled keypair-free Anchor sample")
    anchor_scaffold.add_argument("directory")
    anchor_scaffold.set_defaults(func=command_anchor_scaffold)
    anchor_build = anchor_sub.add_parser("build", help="compile without loading or creating keypairs")
    anchor_build.add_argument("directory", nargs="?", default=".")
    anchor_build.add_argument("--offline", action="store_true", help="require cached crates and disable Cargo network access")
    anchor_build.set_defaults(func=command_anchor_build)

    execute = sub.add_parser("exec", help="run a verified tool through the non-custodial guard")
    execute.add_argument(
        "tool",
        choices=(
            "forge",
            "cast",
            "node",
            "npm",
            "npx",
            "bun",
            "bunx",
            "solc",
            "solc-select",
            "crytic-compile",
            "slither",
            "echidna",
            "anvil",
            "surfpool",
            "solana",
            "anchor",
            "cargo",
            "rustc",
            "cargo-build-sbf",
        ),
    )
    execute.add_argument("tool_args", nargs=argparse.REMAINDER)
    execute.set_defaults(func=command_exec)

    shell = sub.add_parser("shell", help="enter a shell with verified tool wrappers first in PATH")
    shell.set_defaults(func=command_shell)

    explorer = sub.add_parser("open-explorer", help="open a validated explorer deep link")
    explorer.add_argument("kind", nargs="?", choices=("block", "tx", "address"))
    explorer.add_argument("value", nargs="?")
    explorer.set_defaults(func=command_open_explorer)

    update = sub.add_parser("update", help="update the workstation")
    update.set_defaults(func=command_lifecycle, action="update", purge=False)
    uninstall = sub.add_parser("uninstall", help="uninstall the workstation")
    uninstall.add_argument("--purge", action="store_true", help="also remove owned configuration and cache")
    uninstall.set_defaults(func=command_lifecycle, action="uninstall")

    internal = sub.add_parser("internal", help=argparse.SUPPRESS)
    internal.add_argument("action", choices=("install-menu", "remove-menu"))
    internal.set_defaults(func=command_internal)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.command == "configure" and not args.clear:
        if not args.rpc_url or args.chain_id is None:
            parser.error("configure requires --rpc-url and --chain-id unless --clear is used")
    try:
        return int(args.func(args))
    except RuntimeError as exc:
        print(f"limechain-web3: {exc}", file=sys.stderr)
        return 2
    except subprocess.TimeoutExpired:
        print("limechain-web3: command timed out", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
